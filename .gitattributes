# Normalisasi line endings dan tipe file
*        text=auto

# Kode & skrip
*.py     text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Data/teks umum
*.csv    text eol=lf
*.tsv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Notebook
*.ipynb  text eol=lf