# Normalisasi line endings dan tipe file
*        text=auto
# Kode & skrip
*.py     text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf
# Data/teks umum
*.csv    text eol=lf
*.tsv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
# Notebook
*.ipynb  text eol=lf
*.shp filter=lfs diff=lfs merge=lfs -text
*.dbf filter=lfs diff=lfs merge=lfs -text
*.shx filter=lfs diff=lfs merge=lfs -text
*.prj filter=lfs diff=lfs merge=lfs -text
*.cpg filter=lfs diff=lfs merge=lfs -text
